{
  "name": "dsh-zju-assistant",
  "version": "0.1.2",
  "description": "ZJU All-in-One Assistant：浙大学生的一站式校园助手，装进 DeepSeek Harness。课表、作业、通知、学习页、日程表，和已授权的选课、预约、交作业",
  "icon": "./icon.svg",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anchorite-no/dsh-zju-assistant.git",
    "directory": "plugin/bundle"
  },
  "homepage": "https://github.com/Anchorite-no/dsh-zju-assistant#readme",
  "bugs": {
    "url": "https://github.com/Anchorite-no/dsh-zju-assistant/issues"
  },
  "author": "Anchorite",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "zju",
    "zhejiang-university"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dependencies": {
    "dsh-zju-campus": "0.1.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "今日校园",
      "en": "Campus today"
    },
    "icon": "school",
    "contributes": {
      "composer.actions": [
        {
          "id": "campus-ask",
          "label": {
            "zh": "今日校园",
            "en": "Campus"
          },
          "icon": "school",
          "effect": {
            "type": "insert",
            "text": "看看我今天的课表和最近的截止时间。"
          }
        },
        {
          "id": "campus-calendar",
          "label": {
            "zh": "写入日历",
            "en": "Calendar"
          },
          "icon": "calendar"
        }
      ],
      "composer.strip": [
        {
          "id": "campus-strip",
          "icon": "school",
          "text": "今日校园",
          "panel": "campus"
        }
      ],
      "panels": [
        {
          "id": "campus",
          "title": {
            "zh": "今日校园",
            "en": "Campus today"
          },
          "icon": "school",
          "placement": [
            "features",
            "chat.panel"
          ]
        }
      ]
    }
  }
}
